# エラトステネスのふるいを使って素数を表示する
#
# @2~@200 素数かどうかを記録する配列。0=非素数、1=素数

# @1002 最大値200を設定
@1002
+200

# @1000 ループのカウンター
@1000
+1

[
	@1000
	+1

	# @1001に素数の倍数を保持する
	@1001
	_
	+&1000

	@&1001
	?
		# 非素数はスキップ
	:
		# 素数はプリントする
		@1001
		pd
		cr

		@0
		_
		+1
		[
			# 素数の倍数を非素数としてマークする
			@1001
			+&1000
			@&1001
			+1

			# 素数の倍数が最大値より大きければループ終了
			@0
			_
			+&1001
			-1
			/&1002
			?
				_
			:
				+1
			;
		]
	;

	# 現在の数字が最大値より大きければループ終了
	@0
	_
	+&1000
	-&1002
]


