# fizz function
# セル2:倍数判定の数字
# セル4:fizzを表示したら1を代入
fn_3の倍数でfizz
	@2
	+&1
	%3
	?
	:
		echo "fizz"
		@4
		+1
	;
	@2
	_
end_fn

# buzz function
# セル2:倍数判定の数字
# セル4:buzzを表示したら1を代入
fn_5の倍数でbuzz
	@3
	+&1
	%5
	?
	:
		echo "buzz"
		@4
		+1
	;
	@3
	_
end_fn

# セル0：カウンター
# セル1：数字をインクリメントする
@0
+30
@1
+1
[
	@1
	call_3の倍数でfizz
	call_5の倍数でbuzz
	@4
	?
		# セル4が1だったら改行
		cr
		@4
		_
	:
		# セル4が0だったら数字を表示
		@1
		pd
		cr
	;
	@1
	+1
	@0
	-1
]




